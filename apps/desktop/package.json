{
  "name": "bizmanage-desktop",
  "version": "2.0.0",
  "productName": "BizManage Desktop",
  "description": "BizManage ERP & POS Counter Desktop Client",
  "author": "BizManage ERP",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dist": "tsc && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.bizmanage.desktop",
    "productName": "BizManage Desktop",
    "copyright": "Copyright © 2026 BizManage ERP",
    "directories": {
      "output": "build-output"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "../web/public/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BizManage Desktop",
      "artifactName": "BizManage-Desktop-Setup.exe"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "typescript": "^5.0.0"
  }
}