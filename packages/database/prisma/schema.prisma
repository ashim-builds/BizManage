datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  BILLER
  ACCOUNTANT
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum AccountType {
  CASH
  BANK
  MOBILE_WALLET
}

enum PaymentMode {
  CASH
  BANK
  CHEQUE
  ONLINE
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

enum StockMovementType {
  INITIAL
  SALE
  PURCHASE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  CANCELLED
  RETURNED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

enum TransactionCategory {
  SALE
  PURCHASE
  SALE_RETURN
  PURCHASE_RETURN
  PAYMENT_IN
  PAYMENT_OUT
  EXPENSE
  INCOME
  TRANSFER
}

model User {
  id                String               @id @default(uuid())
  email             String               @unique
  passwordHash      String?
  name              String
  phone             String?
  avatarUrl         String?
  googleId          String?              @unique
  isVerified        Boolean              @default(false)
  readNotifications NotificationRead[]
  activeBusinessId  String?
  isSystemAdmin     Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  memberships       UserBusinessRole[]
  sessions          Session[]
  resetTokens       PasswordResetToken[]
  systemLogs        SystemLog[]
  auditLogs         AuditLog[]
  otpVerification   OtpVerification?
  failedLoginAttempts Int              @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  
  // E2EE Key Management
  publicKey           String?  @db.Text
  encryptedPrivateKey String?  @db.Text
  kdfSalt             String?
}

model OtpVerification {
  id        String   @id @default(uuid())
  userId    String   @unique
  otpHash   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  device       String?
  browser      String?
  os           String?
  ipAddress    String?
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationRead {
  id             String   @id @default(uuid())
  userId         String
  notificationId String
  readAt         DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
}

model Business {
  id                    String               @id @default(uuid())
  name                  String
  phone                 String?
  email                 String?
  address               String?
  taxNumber             String?
  currency              String               @default("NPR")
  logoUrl               String?
  subscriptionPackageId String?
  subscriptionStatus    String               @default("ACTIVE") // ACTIVE, TRIAL, EXPIRED, CANCELLED
  trialEndsAt           DateTime?
  currentPeriodEnd      DateTime?
  planOverrides         Json? // Optional overrides like { maxMembers: 100 }
  isActive              Boolean              @default(true)
  profileCompleted      Boolean              @default(false)
  setupCompleted        Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  memberships           UserBusinessRole[]
  settings              BusinessSetting?
  partyCategories       PartyCategory[]
  itemCategories        ItemCategory[]
  parties               Party[]
  items                 Item[]
  stockMovements        StockMovement[]
  quotations            Quotation[]
  sales                 Sale[]
  saleReturns           SaleReturn[]
  purchases             Purchase[]
  purchaseReturns       PurchaseReturn[]
  paymentsIn            PaymentIn[]
  paymentsOut           PaymentOut[]
  expenses              Expense[]
  incomes               Income[]
  accounts              Account[]
  transactions          Transaction[]
  accountTransfers      AccountTransfer[]
  
  subscriptionPackage   SubscriptionPackage? @relation(fields: [subscriptionPackageId], references: [id])
  subscriptions         Subscription[]
  billingInvoices       BillingInvoice[]
  subscriptionPayments  SubscriptionPayment[]
  subscriptionNotifs    SubscriptionNotification[]
  auditLogs             AuditLog[]
}

model UserBusinessRole {
  id         String   @id @default(uuid())
  userId     String
  businessId String
  role       Role     @default(ADMIN)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

model BusinessSetting {
  id                   String   @id @default(uuid())
  businessId           String   @unique
  enableTax            Boolean  @default(false)
  taxRate              Decimal  @default(0) @db.Decimal(5, 2)
  invoicePrefix        String   @default("INV-")
  purchasePrefix       String   @default("PUR-")
  quotationPrefix      String   @default("QT-")
  saleReturnPrefix     String   @default("CN-")
  purchaseReturnPrefix String   @default("DN-")
  lowStockAlert        Boolean  @default(true)
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model PartyCategory {
  id         String   @id @default(uuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parties    Party[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Party {
  id              String           @id @default(uuid())
  businessId      String
  categoryId      String?
  name            String
  type            PartyType
  phone           String?
  email           String?
  address         String?
  taxNumber       String?
  openingBalance  Decimal          @default(0) @db.Decimal(12, 2)
  currentBalance  Decimal          @default(0) @db.Decimal(12, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category        PartyCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quotations      Quotation[]
  sales           Sale[]
  saleReturns     SaleReturn[]
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  paymentsIn      PaymentIn[]
  paymentsOut     PaymentOut[]

  @@index([businessId, name])
  @@index([businessId, type])
  @@index([businessId, categoryId])
}

model ItemCategory {
  id         String   @id @default(uuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items      Item[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Item {
  id                  String               @id @default(uuid())
  businessId          String
  categoryId          String?
  name                String
  code                String?
  type                ItemType             @default(PRODUCT)
  unit                String               @default("Pcs")
  salePrice           Decimal              @default(0) @db.Decimal(12, 2)
  purchasePrice       Decimal              @default(0) @db.Decimal(12, 2)
  openingStock        Decimal              @default(0) @db.Decimal(12, 3)
  currentStock        Decimal              @default(0) @db.Decimal(12, 3)
  minStockAlert       Decimal              @default(0) @db.Decimal(12, 3)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category            ItemCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quotationItems      QuotationItem[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  stockMovements      StockMovement[]
  
  // E2EE Metadata
  encryptedDeks       Json?
  iv                  String?
  hmacName            String?
  hmacCode            String?
  encPurchasePrice    String?
  encSalePrice        String?

  @@index([businessId, name])
  @@index([businessId, code])
  @@index([businessId, hmacName])
  @@index([businessId, hmacCode])
  @@index([businessId, categoryId])
  @@index([businessId, currentStock])
}

model StockMovement {
  id         String            @id @default(uuid())
  businessId String
  itemId     String
  type       StockMovementType
  quantity   Decimal           @db.Decimal(12, 3)
  reference  String?
  createdAt  DateTime          @default(now())
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  item       Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([businessId, itemId])
  @@index([businessId, createdAt])
}

model Quotation {
  id              String          @id @default(uuid())
  businessId      String
  partyId         String
  quotationNumber String
  date            DateTime
  validUntil      DateTime?
  status          QuotationStatus @default(DRAFT)
  subTotal        Decimal         @db.Decimal(12, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(12, 2)
  discountPercent Decimal         @default(0) @db.Decimal(5, 2)
  discount        Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party           Party           @relation(fields: [partyId], references: [id], onDelete: Restrict)
  items           QuotationItem[]

  @@unique([businessId, quotationNumber])
  @@index([businessId, date])
}

model QuotationItem {
  id              String    @id @default(uuid())
  quotationId     String
  itemId          String
  quantity        Decimal   @db.Decimal(12, 3)
  unitPrice       Decimal   @db.Decimal(12, 2)
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  discount        Decimal   @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal   @default(0) @db.Decimal(12, 2)
  total           Decimal   @db.Decimal(12, 2)
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  item            Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
}

model Sale {
  id              String        @id @default(uuid())
  businessId      String
  partyId         String
  invoiceNumber   String
  date            DateTime
  dueDate         DateTime?
  status          InvoiceStatus @default(UNPAID)
  isVatBill       Boolean       @default(false)
  subTotal        Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(12, 2)
  discountPercent Decimal       @default(0) @db.Decimal(5, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(12, 2)
  dueAmount       Decimal       @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party           Party         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  items           SaleItem[]
  returns         SaleReturn[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, partyId])
  @@index([businessId, date])
}

model SaleItem {
  id               String  @id @default(uuid())
  saleId           String
  itemId           String
  quantity         Decimal @db.Decimal(12, 3)
  unitPrice        Decimal @db.Decimal(12, 2)
  discountPercent  Decimal @default(0) @db.Decimal(5, 2)
  discount         Decimal @default(0) @db.Decimal(12, 2)
  returnedQuantity Decimal @default(0) @db.Decimal(12, 3)
  taxAmount        Decimal @default(0) @db.Decimal(12, 2)
  total            Decimal @db.Decimal(12, 2)
  sale             Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item             Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([itemId])
}

model SaleReturn {
  id              String           @id @default(uuid())
  businessId      String
  saleId          String?
  partyId         String
  returnNumber    String
  date            DateTime
  subTotal        Decimal          @db.Decimal(12, 2)
  taxAmount       Decimal          @default(0) @db.Decimal(12, 2)
  discountPercent Decimal          @default(0) @db.Decimal(5, 2)
  discount        Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal          @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sale            Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  party           Party            @relation(fields: [partyId], references: [id], onDelete: Restrict)
  items           SaleReturnItem[]

  @@unique([businessId, returnNumber])
  @@index([businessId, date])
}

model SaleReturnItem {
  id              String     @id @default(uuid())
  saleReturnId    String
  itemId          String
  quantity        Decimal    @db.Decimal(12, 3)
  unitPrice       Decimal    @db.Decimal(12, 2)
  discountPercent Decimal    @default(0) @db.Decimal(5, 2)
  discount        Decimal    @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal    @default(0) @db.Decimal(12, 2)
  total           Decimal    @db.Decimal(12, 2)
  saleReturn      SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  item            Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([saleReturnId])
  @@index([itemId])
}

model Purchase {
  id              String           @id @default(uuid())
  businessId      String
  partyId         String
  billNumber      String
  date            DateTime
  status          InvoiceStatus    @default(UNPAID)
  isVatBill       Boolean          @default(false)
  subTotal        Decimal          @db.Decimal(12, 2)
  taxAmount       Decimal          @default(0) @db.Decimal(12, 2)
  discountPercent Decimal          @default(0) @db.Decimal(5, 2)
  discount        Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal          @db.Decimal(12, 2)
  paidAmount      Decimal          @default(0) @db.Decimal(12, 2)
  dueAmount       Decimal          @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party           Party            @relation(fields: [partyId], references: [id], onDelete: Restrict)
  items           PurchaseItem[]
  returns         PurchaseReturn[]

  @@unique([businessId, billNumber])
  @@index([businessId, partyId])
  @@index([businessId, date])
}

model PurchaseItem {
  id               String   @id @default(uuid())
  purchaseId       String
  itemId           String
  quantity         Decimal  @db.Decimal(12, 3)
  unitPrice        Decimal  @db.Decimal(12, 2)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2)
  discount         Decimal  @default(0) @db.Decimal(12, 2)
  returnedQuantity Decimal  @default(0) @db.Decimal(12, 3)
  taxAmount        Decimal  @default(0) @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  purchase         Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([itemId])
}

model PurchaseReturn {
  id              String               @id @default(uuid())
  businessId      String
  purchaseId      String?
  partyId         String
  returnNumber    String
  date            DateTime
  subTotal        Decimal              @db.Decimal(12, 2)
  taxAmount       Decimal              @default(0) @db.Decimal(12, 2)
  discountPercent Decimal              @default(0) @db.Decimal(5, 2)
  discount        Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal              @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchase        Purchase?            @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  party           Party                @relation(fields: [partyId], references: [id], onDelete: Restrict)
  items           PurchaseReturnItem[]

  @@unique([businessId, returnNumber])
  @@index([businessId, date])
}

model PurchaseReturnItem {
  id               String         @id @default(uuid())
  purchaseReturnId String
  itemId           String
  quantity         Decimal        @db.Decimal(12, 3)
  unitPrice        Decimal        @db.Decimal(12, 2)
  discountPercent  Decimal        @default(0) @db.Decimal(5, 2)
  discount         Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal        @default(0) @db.Decimal(12, 2)
  total            Decimal        @db.Decimal(12, 2)
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  item             Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([purchaseReturnId])
  @@index([itemId])
}

model Account {
  id            String            @id @default(uuid())
  businessId    String
  accountName   String
  accountType   AccountType       @default(CASH)
  accountNumber String?
  bankName      String?
  balance       Decimal           @default(0) @db.Decimal(12, 2)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  paymentsIn    PaymentIn[]
  paymentsOut   PaymentOut[]
  expenses      Expense[]
  incomes       Income[]
  transactions  Transaction[]
  transfersOut  AccountTransfer[] @relation("TransfersOut")
  transfersIn   AccountTransfer[] @relation("TransfersIn")

  @@unique([businessId, accountName])
  @@index([businessId])
}

model PaymentIn {
  id              String        @id @default(uuid())
  businessId      String
  partyId         String
  accountId       String
  amount          Decimal       @db.Decimal(12, 2)
  mode            PaymentMode
  status          PaymentStatus @default(COMPLETED)
  date            DateTime
  referenceNumber String?
  notes           String?
  createdAt       DateTime      @default(now())
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party           Party         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([businessId, partyId])
  @@index([businessId, date])
}

model PaymentOut {
  id              String        @id @default(uuid())
  businessId      String
  partyId         String
  accountId       String
  amount          Decimal       @db.Decimal(12, 2)
  mode            PaymentMode
  status          PaymentStatus @default(COMPLETED)
  date            DateTime
  referenceNumber String?
  notes           String?
  createdAt       DateTime      @default(now())
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  party           Party         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([businessId, partyId])
  @@index([businessId, date])
}

model Expense {
  id          String      @id @default(uuid())
  businessId  String
  accountId   String
  category    String
  amount      Decimal       @db.Decimal(12, 2)
  paymentMode PaymentMode
  status      PaymentStatus @default(COMPLETED)
  date        DateTime
  description String?
  createdAt   DateTime    @default(now())
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([businessId, category])
  @@index([businessId, date])
}

model Income {
  id          String      @id @default(uuid())
  businessId  String
  accountId   String
  category    String
  amount      Decimal       @db.Decimal(12, 2)
  paymentMode PaymentMode
  status      PaymentStatus @default(COMPLETED)
  date        DateTime
  description String?
  createdAt   DateTime    @default(now())
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([businessId, category])
  @@index([businessId, date])
}

model Transaction {
  id          String              @id @default(uuid())
  businessId  String
  accountId   String?
  category    TransactionCategory
  amount      Decimal             @db.Decimal(12, 2)
  referenceId String?
  description String?
  date        DateTime
  createdAt   DateTime            @default(now())
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account     Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([businessId, category])
  @@index([businessId, date])
  @@index([businessId, accountId])
}

model AccountTransfer {
  id              String   @id @default(uuid())
  businessId      String
  fromAccountId   String
  toAccountId     String
  amount          Decimal  @db.Decimal(12, 2)
  date            DateTime
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromAccount     Account  @relation("TransfersOut", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount       Account  @relation("TransfersIn", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([businessId, date])
}

// -----------------------------------------------------------------------------
// System Admin Models
// -----------------------------------------------------------------------------

model SubscriptionPackage {
  id            String   @id @default(uuid())
  name          String   @unique
  price         Decimal  @db.Decimal(10, 2)
  currency      String   @default("NPR")
  billingPeriod String   @default("MONTHLY") // MONTHLY, YEARLY
  trialDays     Int      @default(0)
  features      Json     @default("[]")
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  businesses            Business[]
  subscriptions         Subscription[]
  subscriptionPayments  SubscriptionPayment[]
}

model Subscription {
  id                    String              @id @default(uuid())
  businessId            String
  subscriptionPackageId String
  status                String              @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED, PENDING
  startDate             DateTime
  endDate               DateTime
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  business              Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptionPackage   SubscriptionPackage @relation(fields: [subscriptionPackageId], references: [id], onDelete: Restrict)
  billingInvoices       BillingInvoice[]
  notifications         SubscriptionNotification[]

  @@index([businessId])
  @@index([endDate])
  @@index([status])
}

model BillingInvoice {
  id              String              @id @default(uuid())
  invoiceNumber   String              @unique
  businessId      String
  subscriptionId  String?
  amount          Decimal             @db.Decimal(10, 2)
  discount        Decimal             @default(0) @db.Decimal(10, 2)
  tax             Decimal             @default(0) @db.Decimal(10, 2)
  total           Decimal             @db.Decimal(10, 2)
  paidAmount      Decimal             @default(0) @db.Decimal(10, 2)
  status          String              @default("PENDING") // PENDING, PARTIALLY_PAID, PAID, FAILED, CANCELLED
  dueDate         DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription    Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments        SubscriptionPayment[]

  @@index([businessId])
  @@index([subscriptionId])
}

model SubscriptionNotification {
  id               String       @id @default(uuid())
  businessId       String
  subscriptionId   String
  notificationType String       // 30D, 7D, 3D, 1D, EXPIRED
  sentAt           DateTime     @default(now())

  business         Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([businessId, subscriptionId])
}

model SubscriptionPayment {
  id                    String              @id @default(uuid())
  businessId            String
  subscriptionPackageId String
  invoiceId             String?
  amount                Decimal             @db.Decimal(10, 2)
  status                String              @default("PENDING") // PENDING, COMPLETED, FAILED
  gateway               String              @default("eSewa")
  gatewayTransactionUuid String?            @unique
  gatewayStatus         String?
  referenceId           String?             // Gateway reference
  failureReason         String?
  verificationResponse  Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  business              Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptionPackage   SubscriptionPackage @relation(fields: [subscriptionPackageId], references: [id], onDelete: Restrict)
  billingInvoice        BillingInvoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([subscriptionPackageId])
  @@index([invoiceId])
}

model SystemLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String // e.g., "LOGIN", "BUSINESS_SUSPEND", "SETTING_UPDATE"
  targetId   String? // ID of affected resource
  targetType String? // e.g., "Business", "User", "PlatformSetting"
  details    Json? // Context about the change
  ipAddress  String?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
}

model PlatformSetting {
  id                  String   @id @default(uuid())
  maintenanceMode     Boolean  @default(false)
  registrationEnabled Boolean  @default(true)
  supportEmail        String   @default("support@bizmanage.com")
  globalAnnouncement  String?
  updatedAt           DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  businessId String?
  action     String
  module     String
  recordId   String?
  ipAddress  String?
  details    Json?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, module])
  @@index([businessId, createdAt])
  @@index([userId, createdAt])
}
