{
  "name": "@bizmanage/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc --build",
    "dev": "tsc --build --watch",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma db push --accept-data-loss",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@bizmanage/types": "workspace:*",
    "@prisma/client": "^5.13.0"
  },
  "devDependencies": {
    "@bizmanage/config": "workspace:*",
    "prisma": "^5.13.0",
    "typescript": "^5.4.5"
  }
}
