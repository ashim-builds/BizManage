# ─────────────────────────────────────────────────────────────────────────────
# BizManage SaaS — Production Environment Variables
# Copy this file to .env and fill in all values before deploying.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://bizmanage:CHANGE_ME_STRONG_PASSWORD@db_host:5432/bizmanage?schema=public&sslmode=require

# For Docker Compose, use the service name as host:
# DATABASE_URL=postgresql://bizmanage:CHANGE_ME@postgres:5432/bizmanage?schema=public
POSTGRES_USER=bizmanage
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=bizmanage

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must be at least 32 characters. Use unique values for each environment.
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32_DIFFERENT

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Must be exact URLs (no wildcards).
# Example: https://app.yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=https://app.yourdomain.com

# eSewa ePay v2 production configuration. Obtain both values from eSewa.
# Never use EPAYTEST or the UAT secret in production.
ESEWA_ENVIRONMENT=production
ESEWA_MERCHANT_CODE=YOUR_ESEWA_PRODUCTION_PRODUCT_CODE
ESEWA_SECRET_KEY=YOUR_ESEWA_PRODUCTION_SECRET
FRONTEND_URL=https://app.yourdomain.com

# ── Frontend ─────────────────────────────────────────────────────────────────
# Public API URL — must be reachable from the browser (not internal Docker hostname)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
