# ─────────────────────────────────────────────────────────────────────────────
# BizManage SaaS — Production Environment Variables
# Copy this file to .env and fill in all values before deploying.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://bizmanage:CHANGE_ME_STRONG_PASSWORD@db_host:5432/bizmanage?schema=public&sslmode=require

POSTGRES_USER=bizmanage
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=bizmanage

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32_DIFFERENT

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://app.yourdomain.com

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# ── SMTP Email System ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=BizManage

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=184976106440-gpo88k2plo9ff1niqt2dg8pi7df98qer.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_URL=https://app.yourdomain.com/auth/google/callback
